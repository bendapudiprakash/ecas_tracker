# ==============================================================================
# eCAS Portfolio Tracker - Environment Configuration Template
# Copy this file to '.env' and fill in your personal credentials.
# NOTE: DO NOT commit your actual '.env' file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Single Mailbox Configuration
# ------------------------------------------------------------------------------
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=abcd1234efgh5678
PDF_PASSWORD=YOUR_PAN_NUMBER

# ------------------------------------------------------------------------------
# OPTION 2: Multi-Mailbox & Family Portfolio View (Indexed Mailboxes)
# Automatically syncs statements from multiple family members & maps passwords
# ------------------------------------------------------------------------------
# Family Member 1 (Self)
MAILBOX_1_USER=user1@gmail.com
MAILBOX_1_APP_PASSWORD=app_password_1
MAILBOX_1_PDF_PASSWORD=PAN1_PASSWORD

# Family Member 2 (Spouse / Parent)
MAILBOX_2_USER=user2@gmail.com
MAILBOX_2_APP_PASSWORD=app_password_2
MAILBOX_2_PDF_PASSWORD=PAN2_PASSWORD

# ------------------------------------------------------------------------------
# OPTION 3: JSON Config Mode (Alternative Multi-Mailbox format)
# ------------------------------------------------------------------------------
# GMAIL_ACCOUNTS_JSON='[{"user":"user1@gmail.com","app_password":"pass1","pdf_password":"PAN1"},{"user":"user2@gmail.com","app_password":"pass2","pdf_password":"PAN2"}]'
